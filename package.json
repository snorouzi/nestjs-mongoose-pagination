{
	"name": "nestjs-mongoose-pagination",
	"version": "1.1.0",
	"description": "A custom pagination solution for Mongoose and NestJS",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"format": "prettier --write \"src/**/*.ts\"",
		"prepack": "npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/snorouzi/nestjs-mongoose-pagination.git"
	},
	"author": "Saeed Norouzi",
	"keywords": [
		"nestjs",
		"mongoose",
		"pagination",
		"paginate"
	],
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/snorouzi/nestjs-mongoose-pagination/issues"
	},
	"homepage": "https://github.com/snorouzi/nestjs-mongoose-pagination#readme",
	"dependencies": {
		"@nestjs/common": "^11.0.1",
		"@nestjs/core": "^11.0.1",
		"@nestjs/mongoose": "^11.0.4",
		"@nestjs/swagger": "^11.4.4",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"mongoose": "^9.7.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.7",
		"prettier": "^3.4.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3"
	}
}
